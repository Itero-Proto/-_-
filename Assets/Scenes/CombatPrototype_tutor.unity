  m_GameObject: {fileID: 1773093948}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 56ca1186c45cb614bbb9626e33d01b07, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  tutorialCamera: {fileID: 1778375875}
  playerParry: {fileID: 709571599}
  tutorialPanel: {fileID: 67778944}
  tutorialText: {fileID: 1836051169}
  nextButton: {fileID: 1207395753}
  messages:
  - "\u0422\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0442\u0435\u043B \u0443\u043A\u0440\u0430\u0441\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0442\u044B\u043A\u0432,\u043D\u043E \u0441\u043E\u0441\u0435\u0434 \u0441\u043F\u0440\u044F\u0442\u0430\u043B \u043A\u0430\u043C\u0435\u0440\u044B \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0432 \u0442\u044B\u043A\u0432\u0430\u0445.. \u041D\u0435 \u0434\u0430\u0439 \u0441\u0435\u0431\u044F \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C."
  - "\u041F\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u043D\u0435\u043B\u044C\u0437\u044F \u0432\u0435\u0434\u044C \u0432\u0441\u0435\u0433\u043E \u043E\u0434\u0438\u043D \u0448\u0430\u0433 \u0438 \u0442\u044B \u043F\u043E\u043F\u0430\u043B\u0441\u044F! \u041D\u043E \u044D\u0442\u043E \u043D\u0435 \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E \u0442\u044B \u0431\u0435\u0437\u0437\u0430\u0449\u0438\u0442\u0435\u043D. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u043D\u043E\u0436\u0438\u043A \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0441\u0438\u0433\u043D\u0430\u043B\u044B \u043A\u0430\u043C\u0435\u0440."
  - "\u041A\u043E\u0433\u0434\u0430 \u043A\u0430\u043C\u0435\u0440\u0430 \u0442\u0435\u0431\u044F \u0437\u0430\u043C\u0435\u0442\u0438\u0442 \u0438 \u043F\u0443\u0441\u0442\u0438\u0442 \u0441\u0438\u0433\u043D\u0430\u043B, \u043D\u0430\u0436\u043C\u0438 SPACE, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0440\u0430\u0437\u0438\u0442\u044C \u0441\u0438\u0433\u043D\u0430\u043B \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
  - "\u041D\u0430\u0436\u043C\u0438 SPACE \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435\u043C \u0432\u044B\u043F\u0443\u0449\u0435\u043D\u043D\u043E\u0433\u043E \u0441\u0438\u0433\u043D\u0430\u043B\u0430. \u0418\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442 \u0442\u0435\u0431\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0438 \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0442 \u0437\u0430\u043F\u0430\u0441 \u0441\u0438\u043B."
